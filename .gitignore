data/**
!data/**/
!data/**/.gitkeep
outputs/
*.gguf
*.safetensors
wandb/

# Environments and secrets
.env
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
